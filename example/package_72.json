{
  "name": "react-native-touch-through-view-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "hdc rport tcp:8081 tcp:8081 && react-native start",
    "codegen": "npm run codegen:lib && react-native codegen-harmony --ets-output-path ./harmony/entry/src/main/ets/generated",
    "dev": "npm run codegen && react-native bundle-harmony --dev --minify=false",
    "prod": "npm run codegen && react-native bundle-harmony --dev=false --minify=true",
    "postinstall": "node scripts/prepare-testerino.js && node ./scripts/create-build-profile",
    "pack:pkg": "npm --prefix .. run pack",
    "install:pkg": "npm run pack:pkg && npm install @react-native-ohos/react-native-touch-through-view@file:../react-native-ohos-react-native-touch-through-view-1.2.1-beta.1.tgz --legacy-peer-deps",
    "fast-install-project": "npm run pack:pkg && npm install --legacy-peer-deps",
    "fastpkg": "npm run fast-install-project && npm run dev",
    "fast:pkg": "npm run fastpkg",
    "codegen:lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name react-native-touch-through-view --cpp-output-path ../harmony/touch_through_view/src/main/cpp/generated --ets-output-path ../harmony/touch_through_view/src/main/ets/generated --cpp-components-spec-paths ../specs"
  },
  "dependencies": {
    "@react-native-oh/react-native-harmony": "npm:@react-native-oh/react-native-harmony@0.72.143",
    "@react-native-ohos/react-native-image-pan-zoom": "2.2.0",
    "@react-native-ohos/react-native-touch-through-view": "file:../react-native-ohos-react-native-touch-through-view-1.2.1-beta.1.tgz",
    "@rnoh/testerino": "file:rnoh_package/testerino/rnoh-testerino-0.0.12.tgz",
    "react": "18.2.0",
    "react-native": "0.72.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "11.3.7",
    "@react-native-community/cli-platform-android": "11.3.7",
    "@react-native-community/cli-platform-ios": "11.3.7",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native-oh/react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@0.72.143",
    "@react-native/metro-config": "0.72.9",
    "@tsconfig/react-native": "^3.0.0",
    "@types/d3-scale-chromatic": "^3.0.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.24",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "3.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.5.4",
    "json5": "^2.2.3",
    "@react-native/babel-preset": "npm:metro-react-native-babel-preset@0.76.8",
    "@react-native/typescript-config": "npm:@tsconfig/react-native@3.0.0"
  },
  "overrides": {
    "@react-native-community/cli": "11.3.7",
    "@react-native/codegen": "0.74.0"
  },
  "resolutions": {
    "@react-native-community/cli": "11.3.7"
  },
  "engines": {
    "node": ">=18"
  }
}
